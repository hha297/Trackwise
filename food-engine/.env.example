# Trackwise Food Engine — environment placeholders (never commit real secrets)

APP_ENV=development
APP_NAME=Trackwise Food Intelligence
APP_VERSION=0.3.0
API_V1_PREFIX=/api/v1

# Container / Railway listen port (Dockerfile defaults to 8000 when unset).
PORT=8000

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Optional temporary HS256 legacy secret (prefer JWKS/ES256 in production).
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Least-privilege Postgres DSNs (sslmode=require). Never use the superuser / service_role.
# DATABASE_URL is an alias for the app pool when DATABASE_APP_URL is unset.
DATABASE_URL=
DATABASE_APP_URL=
DATABASE_WORKER_URL=
DATABASE_ADMIN_URL=
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=30

# Shared secret for worker HTTP routes (X-Food-Engine-Worker-Token).
FOOD_ENGINE_WORKER_TOKEN=

# Public R2 (approved images only) — trackwise-food-images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional; derived as https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com when empty.
R2_ENDPOINT=
R2_PUBLIC_BUCKET=trackwise-food-images
R2_PUBLIC_URL=https://images.trackwise.one

# Private R2 (candidates / originals) — create manually in Cloudflare if API CreateBucket is denied.
# Alias R2_PRIVATE_BUCKET_NAME is also accepted by Settings.
R2_PRIVATE_BUCKET=trackwise-food-ingestion-private
# Optional dedicated keys; when empty, public R2 keys are reused.
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=

OFF_USER_AGENT=TrackwiseFoodEngine/0.3 (https://trackwise.one)
OFF_BASE_URL=https://world.openfoodfacts.org
INGEST_PILOT_BATCH_SIZE=25
INGEST_RATE_LIMIT_PER_SECOND=2
IMAGE_MAX_BYTES=8000000
IMAGE_MIN_DIMENSION=100
IMAGE_MAX_DIMENSION=4096
