{
  "expo": {
    "name": "Trackwise",
    "slug": "trackwise",
    "owner": "hha2907",
    "version": "1.3",
    "orientation": "portrait",
    "icon": "./assets/images/branding/icon.png",
    "scheme": "trackwise",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.trackwise.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Trackwise uses the camera to scan food barcodes.",
        "NSPhotoLibraryUsageDescription": "Trackwise needs photo access so you can add an image to a food you create."
      }
    },
    "android": {
      "package": "com.trackwise.app",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0D110D",
        "foregroundImage": "./assets/images/branding/icon-adaptive-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/branding/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00D95F",
          "image": "./assets/images/branding/logo-splash.png",
          "imageWidth": 112
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Trackwise to use the camera for barcode scanning.",
          "recordAudioAndroid": false
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Trackwise to access your photos to add a food image.",
          "cameraPermission": "Trackwise uses the camera to scan food barcodes."
        }
      ],
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BricolageGrotesque_500Medium.ttf",
            "./assets/fonts/BricolageGrotesque_600SemiBold.ttf",
            "./assets/fonts/BricolageGrotesque_700Bold.ttf",
            "./assets/fonts/JetBrainsMono_600SemiBold.ttf",
            "./assets/fonts/JetBrainsMono_700Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "BricolageGrotesque",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/BricolageGrotesque_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/BricolageGrotesque_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/BricolageGrotesque_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "JetBrainsMono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMono_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMono_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-localization",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#00D95F",
          "defaultChannel": "trackwise-reminders",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.trackwise.app.widgets",
          "groupIdentifier": "group.com.trackwise.app",
          "enableAndroid": true,
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "TrackwiseDaily",
              "displayName": "Trackwise Daily",
              "description": "Calories, protein, water, and streak at a glance.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge"],
                "initialLayout": "./widgets/TrackwiseDaily.ios.tsx"
              },
              "android": {
                "minWidth": 180,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 4,
                "resizeMode": "both",
                "initialLayout": "./widgets/TrackwiseDaily.android.tsx"
              }
            },
            {
              "name": "TrackwiseWorkout",
              "displayName": "Trackwise Workout",
              "description": "Today’s planned or completed workout.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "initialLayout": "./widgets/TrackwiseWorkout.ios.tsx"
              },
              "android": {
                "minWidth": 180,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "horizontal",
                "initialLayout": "./widgets/TrackwiseWorkout.android.tsx"
              }
            }
          ]
        }
      ],
      "./plugins/apply-android-widget-open-app.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabasePublishableKey": "",
      "cloudinaryCloudName": "",
      "cloudinaryUploadPreset": "",
      "adminUrl": "",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "584cc895-be5e-4622-a1b3-f0bd351a6834"
      }
    }
  }
}