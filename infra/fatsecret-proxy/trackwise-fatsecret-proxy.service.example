# Example systemd unit — compare with the existing unit on the VM before changing.
# Do not overwrite a working unit unless the ExecStart path differs.

[Unit]
Description=Trackwise FatSecret Proxy
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trackwise-fatsecret-proxy
EnvironmentFile=/etc/trackwise-fatsecret.env
ExecStart=/home/ubuntu/trackwise-fatsecret-proxy/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
